server {
    if ($host = botdefazer.duckdns.org) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name botdefazer.duckdns.org;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
}

server {
    listen 443 ssl;
    server_name botdefazer.duckdns.org;
    ssl_certificate /etc/letsencrypt/live/botdefazer.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/botdefazer.duckdns.org/privkey.pem;

    root /opt/mro_dash/site;
    index index.html;

    # Proxy dynamic routes to Flask
    location /login {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /callback {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static files
    location = /fcoin {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
